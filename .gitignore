# Java
target/
*.class
# Python
.venv/
venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# Node
node_modules/
frontend/dist/
# Built frontend copied into backend
backend/src/main/resources/static/
# Data and results
data/
experiments/results/*
!experiments/results/.gitkeep
# ...except the small summaries, which docs/08 section 1 asks to keep: PROGRESS.md
# and the paper quote these numbers, so a fresh clone should be able to see them
# without downloading the benchmark and re-running anything. Per-case files
# (cases.csv, *.jsonl) stay out - they are hundreds of kilobytes and regenerate.
!experiments/results/*/
# Un-ignoring the run folder exposes everything in it again, because the rule
# above matched the folder and not its contents. So re-ignore the contents, then
# allow back only the small files.
experiments/results/*/*
!experiments/results/*/summary*.csv
!experiments/results/*/comparison.txt
!experiments/results/*/agreement.txt
!experiments/results/*/report.txt
# The three files docs/08 section 1 says every run folder carries, so a number in
# the paper can be traced to the configuration and the machine that produced it.
# The patterns above were written against M2.4's filenames and missed these.
!experiments/results/*/config.yaml
!experiments/results/*/env.txt
!experiments/results/*/log.txt
# Small, and docs/08 section 8 requires failures to be reported rather than dropped.
!experiments/results/*/failures.csv
!experiments/results/*/config*.json
!experiments/results/*/env-*.txt
# IDE / OS
.idea/
*.iml
.DS_Store
.gstack/
# The replay alarm-timing check (decision 83): 24 rows per file, and the evidence
# behind a default the application ships with, so it is tracked whole.
!experiments/results/m10_replay/*
